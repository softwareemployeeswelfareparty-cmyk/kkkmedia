<%- include('../partials/header') %>

<main class="container" style="padding-top: 1.5rem;">
  
  <!-- Breadcrumbs -->
  <nav class="article-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">முகப்பு</a>
    <span class="separator">/</span>
    <a href="/category/<%= article.category.slug %>"><%= article.category.nameTamil %></a>
    <span class="separator">/</span>
    <span style="color:var(--charcoal-900); font-weight:600;"><%= article.title.substring(0, 40) %>...</span>
  </nav>

  <!-- Top Leaderboard Ad Slot -->
  <%- include('../partials/ad-slot') %>

  <!-- Article Layout Grid -->
  <div class="main-layout-grid">
    <!-- Left Column: Article Body -->
    <article class="article-container">
      
      <div class="article-header">
        <a href="/category/<%= article.category.slug %>" class="category-tag" style="margin-bottom:0.75rem;">
          <%= article.category.nameTamil %>
        </a>
        <h1 class="article-headline"><%= article.title %></h1>
        <p class="article-subheadline"><%= article.shortDescription %></p>
      </div>

      <!-- Author and Publication Meta Bar -->
      <div class="author-bar">
        <div class="author-info">
          <img src="<%= article.author.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80' %>" 
               alt="<%= article.author.name %>" 
               class="author-avatar" />
          <div>
            <div class="author-name"><%= article.author.name %></div>
            <div class="publish-date">
              வெளியீடு: <%= formatTamilDate(article.publishedAt) %> • <%= calculateReadingTime(article.fullContent) %>
              <% if (article.viewCount > 0) { %>
                • <span title="பார்வைகள்"><%= article.viewCount.toLocaleString() %> பார்வைகள்</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Social Share Buttons -->
        <div class="article-share-buttons">
          <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(article.title + ' - ' + currentUrl) %>" 
             target="_blank" rel="noopener" class="share-btn wa" title="WhatsApp பகிர்">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          </a>
          <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(article.title) %>&url=<%= encodeURIComponent(currentUrl) %>" 
             target="_blank" rel="noopener" class="share-btn tw" title="X (Twitter) பகிர்">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(currentUrl) %>" 
             target="_blank" rel="noopener" class="share-btn fb" title="Facebook பகிர்">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"/></svg>
          </a>
          <a href="https://t.me/share/url?url=<%= encodeURIComponent(currentUrl) %>&text=<%= encodeURIComponent(article.title) %>" 
             target="_blank" rel="noopener" class="share-btn tg" title="Telegram பகிர்">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
          </a>
          <button type="button" class="share-btn cp copy-link-btn" data-url="<%= currentUrl %>" title="இணைப்பை நகலெடு">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          </button>
        </div>
      </div>

      <!-- Featured Image -->
      <% if (article.featuredImage) { %>
        <figure class="article-featured-image-wrap">
          <img src="<%= article.featuredImage %>" alt="<%= article.imageAlt || article.title %>" loading="eager" />
          <% if (article.imageAlt) { %>
            <figcaption class="image-caption"><%= article.imageAlt %></figcaption>
          <% } %>
        </figure>
      <% } %>

      <!-- In-Article Ad Slot -->
      <%- include('../partials/ad-slot') %>

      <!-- Article Rich Content -->
      <div class="article-content">
        <%- article.fullContent %>
      </div>

      <!-- Tags Pills -->
      <% if (article.tags && article.tags.length > 0) { %>
        <div class="article-tags-wrap">
          <span class="tag-label">குறிச்சொற்கள்:</span>
          <% article.tags.forEach(function(t) { %>
            <a href="/search?q=<%= encodeURIComponent(t.tag.name) %>" class="tag-pill">
              #<%= t.tag.name %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <!-- Author Bio Box -->
      <% if (article.author.bio) { %>
        <div style="background-color:var(--grey-100); border-radius:var(--border-radius-sm); padding:1.25rem; margin-top:2rem; display:flex; gap:1rem; align-items:center;">
          <img src="<%= article.author.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80' %>" 
               alt="<%= article.author.name %>" 
               style="width:56px; height:56px; border-radius:50%; object-fit:cover;" />
          <div>
            <div style="font-weight:700; color:var(--charcoal-900);"><%= article.author.name %></div>
            <p style="font-size:0.875rem; color:var(--grey-600); margin:0;"><%= article.author.bio %></p>
          </div>
        </div>
      <% } %>

      <!-- Related Articles Section -->
      <% if (typeof related !== 'undefined' && related.length > 0) { %>
        <section style="margin-top:3rem;">
          <div class="section-header">
            <h3 class="section-title">தொடர்புடைய செய்திகள் (Related News)</h3>
          </div>
          <div class="news-cards-grid">
            <% related.forEach(function(rel) { %>
              <article class="news-card">
                <div class="card-thumb-wrap">
                  <a href="/news/<%= rel.slug %>">
                    <img src="<%= rel.featuredImage || 'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=600&q=80' %>" 
                         alt="<%= rel.imageAlt || rel.title %>" 
                         loading="lazy" />
                  </a>
                </div>
                <div class="card-body">
                  <h4 class="card-title" style="font-size:1.05rem;">
                    <a href="/news/<%= rel.slug %>"><%= rel.title %></a>
                  </h4>
                  <div class="card-footer">
                    <span><%= formatTamilDate(rel.publishedAt) %></span>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        </section>
      <% } %>

    </article>

    <!-- Right Sidebar -->
    <aside class="sidebar">
      
      <!-- Trending Widget -->
      <div class="sidebar-widget">
        <h3 class="widget-title">
          <span>அதிகம் வாசிக்கப்பட்டவை</span>
          <span style="color:var(--primary-red); font-size:0.9rem;">🔥 Trending</span>
        </h3>
        <div class="trending-list">
          <% if (typeof trending !== 'undefined' && trending.length > 0) { %>
            <% trending.forEach(function(item, idx) { %>
              <div class="trending-item">
                <span class="trending-rank">0<%= idx + 1 %></span>
                <div class="trending-title">
                  <a href="/news/<%= item.slug %>"><%= item.title %></a>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Sticky Sidebar Ad Slot -->
      <%- include('../partials/ad-slot') %>

      <!-- Categories Widget -->
      <div class="sidebar-widget">
        <h3 class="widget-title">பிற செய்திப் பிரிவுகள்</h3>
        <div class="category-badges-widget">
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(function(cat) { %>
              <a href="/category/<%= cat.slug %>" class="category-badge-link">
                <%= cat.nameTamil %>
              </a>
            <% }); %>
          <% } %>
        </div>
      </div>

    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
