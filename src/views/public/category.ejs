<%- include('../partials/header') %>

<main class="container" style="padding-top: 1.5rem;">
  
  <!-- Breadcrumbs -->
  <nav class="article-breadcrumbs">
    <a href="/" data-i18n="home">முகப்பு</a>
    <span class="separator">/</span>
    <span class="breadcrumb-current" data-cat-slug="<%= category.slug %>"><%= category.nameTamil %></span>
  </nav>

  <!-- Category Title Header -->
  <div class="category-header-banner">
    <h1 class="category-banner-title" data-cat-title="<%= category.slug %>">
      <%= category.nameTamil %>
    </h1>
    <% if (category.description) { %>
      <p class="category-banner-desc" data-cat-desc="<%= category.slug %>"><%= category.description %></p>
    <% } %>
  </div>

  <!-- Top Ad Slot -->
  <%- include('../partials/ad-slot') %>

  <!-- Grid with Sidebar -->
  <div class="main-layout-grid">
    <div class="primary-feed">
      
      <% if (articles && articles.length > 0) { %>
        <div class="news-cards-grid">
          <% articles.forEach(function(article) { %>
            <article class="news-card">
              <div class="card-thumb-wrap">
                <a href="/news/<%= article.slug %>">
                  <img src="<%= article.featuredImage || 'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=600&q=80' %>" 
                       alt="<%= article.imageAlt || article.title %>" 
                       loading="lazy" />
                </a>
                <span class="card-category-pill" data-cat-slug="<%= category.slug %>"><%= category.nameTamil %></span>
              </div>
              <div class="card-body">
                <h2 class="card-title" style="font-size:1.15rem;">
                  <a href="/news/<%= article.slug %>" data-art-slug="<%= article.slug %>"><%= article.title %></a>
                </h2>
                <p class="card-excerpt" data-excerpt-slug="<%= article.slug %>"><%= article.shortDescription %></p>
                <div class="card-footer">
                  <span class="card-date" data-article-date="<%= article.publishedAt ? article.publishedAt.toISOString() : '' %>"><%= formatTamilDate(article.publishedAt) %></span>
                  <span class="card-reading-time" data-read-min="1"><%= calculateReadingTime(article.fullContent) %></span>
                </div>
              </div>
            </article>
          <% }); %>
        </div>

        <!-- Pagination Controls -->
        <% if (pagination.totalPages > 1) { %>
          <div class="pagination-wrap">
            <% if (pagination.page > 1) { %>
              <a href="/category/<%= category.slug %>?page=<%= pagination.page - 1 %>" class="page-btn" data-i18n="prev_page">&laquo; முந்தையது</a>
            <% } %>

            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
              <a href="/category/<%= category.slug %>?page=<%= p %>" class="page-btn <%= p === pagination.page ? 'active' : '' %>">
                <%= p %>
              </a>
            <% } %>

            <% if (pagination.page < pagination.totalPages) { %>
              <a href="/category/<%= category.slug %>?page=<%= pagination.page + 1 %>" class="page-btn" data-i18n="next_page">அடுத்தது &raquo;</a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <div class="empty-state-box">
          <h3 class="empty-state-title" data-i18n="no_articles_title">இந்த பிரிவில் செய்திகள் எதுவும் இல்லை</h3>
          <p class="empty-state-desc" data-i18n="no_articles_desc">விரைவில் புதிய செய்திகள் பதிவேற்றப்படும்.</p>
          <a href="/" class="page-btn" style="margin-top:1rem; display:inline-flex;" data-i18n="go_home">முகப்புக்குச் செல்</a>
        </div>
      <% } %>

    </div>

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-widget">
        <h3 class="widget-title" data-i18n="trending_title">அதிகம் வாசிக்கப்பட்டவை</h3>
        <div class="trending-list">
          <% if (typeof trending !== 'undefined' && trending.length > 0) { %>
            <% trending.forEach(function(item, idx) { %>
              <div class="trending-item">
                <span class="trending-rank">0<%= idx + 1 %></span>
                <div class="trending-title">
                  <a href="/news/<%= item.slug %>" data-art-slug="<%= item.slug %>"><%= item.title %></a>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Categories Widget -->
      <div class="sidebar-widget">
        <h3 class="widget-title" data-i18n="other_categories">பிற செய்திப் பிரிவுகள்</h3>
        <div class="category-badges-widget">
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(function(cat) { %>
              <a href="/category/<%= cat.slug %>" class="category-badge-link <%= cat.slug === category.slug ? 'active' : '' %>" data-cat-slug="<%= cat.slug %>">
                <%= cat.nameTamil %>
              </a>
            <% }); %>
          <% } %>
        </div>
      </div>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
