<%- include('layout-header') %>

<div class="page-header-row">
  <div>
    <h1 class="page-title">மறுதிசைவு மேலாண்மை (URL Redirects)</h1>
    <p class="page-subtitle">பழைய செய்தி முகவரிகளை (URLs) புதிய முகவரிகளுக்கு 301/302 மறுதிசைவு செய்து SEO மதிப்பைத் தக்கவையுங்கள்.</p>
  </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 2fr; gap:1.75rem; margin-bottom: 2rem;">
  <!-- Add Redirect Form -->
  <div class="admin-card">
    <div class="card-header-padded">
      <h2 style="font-size:1.05rem; font-weight:700;">புதிய மறுதிசைவைச் சேர் (Add Redirect)</h2>
    </div>
    <div class="card-body-padded">
      <form id="addRedirectForm">
        <div class="form-group">
          <label class="form-label">பழைய முகவரி / மூலப் பாதை (From URL Path)</label>
          <input type="text" name="fromPath" id="fromPath" class="form-control" placeholder="/news/old-article-slug" required>
          <small style="color:var(--admin-text-muted); font-size:0.75rem;">உதாரணம்: /news/old-story அல்லது /old-topic</small>
        </div>

        <div class="form-group">
          <label class="form-label">புதிய முகவரி / இலக்குப் பாதை (To URL Destination)</label>
          <input type="text" name="toPath" id="toPath" class="form-control" placeholder="/news/new-article-slug" required>
          <small style="color:var(--admin-text-muted); font-size:0.75rem;">உதாரணம்: /news/new-story அல்லது முழு URL</small>
        </div>

        <div class="form-group">
          <label class="form-label">மறுதிசைவு வகை (Redirect Type)</label>
          <select name="statusCode" id="statusCode" class="form-control">
            <option value="301" selected>301 — நிரந்தர மறுதிசைவு (Permanent SEO Redirect)</option>
            <option value="302">302 — தற்காலிக மறுதிசைவு (Temporary Redirect)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; margin-top:0.5rem;" id="btnAddRedirect">
          + மறுதிசைவைச் சேர் (Save Rule)
        </button>
      </form>
    </div>
  </div>

  <!-- Active Redirects List -->
  <div class="admin-card">
    <div class="card-header-padded" style="display:flex; justify-content:space-between; align-items:center;">
      <h2 style="font-size:1.05rem; font-weight:700;">செயலில் உள்ள மறுதிசைவுகள் (Active Rules)</h2>
      <span class="badge" style="background:var(--admin-primary); color:#fff; font-size:0.8rem; padding:0.25rem 0.6rem; border-radius:12px;">
        <%= (typeof redirects !== 'undefined' && redirects) ? redirects.length : 0 %> விதிகள்
      </span>
    </div>
    <div class="card-body-padded" style="padding:0;">
      <div style="overflow-x:auto;">
        <table class="admin-table" style="margin:0;">
          <thead>
            <tr>
              <th>பழைய பாதை (From)</th>
              <th>புதிய பாதை (To)</th>
              <th>வகை</th>
              <th>பார்வைகள் (Hits)</th>
              <th>நடவடிக்கை</th>
            </tr>
          </thead>
          <tbody id="redirectsTableBody">
            <% if (typeof redirects !== 'undefined' && redirects && redirects.length > 0) { %>
              <% redirects.forEach(function(item) { %>
                <tr id="redirect-row-<%= item.id %>">
                  <td>
                    <code style="background:rgba(0,0,0,0.05); padding:0.2rem 0.4rem; border-radius:4px; font-weight:600;"><%= item.fromPath %></code>
                  </td>
                  <td>
                    <code style="background:rgba(0,0,0,0.05); padding:0.2rem 0.4rem; border-radius:4px; color:var(--admin-primary);"><%= item.toPath %></code>
                  </td>
                  <td>
                    <span class="badge <%= item.statusCode === 301 ? 'badge-published' : 'badge-draft' %>" style="padding:0.2rem 0.5rem; font-size:0.75rem;">
                      <%= item.statusCode %>
                    </span>
                  </td>
                  <td>
                    <strong><%= item.hits || 0 %></strong>
                  </td>
                  <td>
                    <button type="button" class="btn-action-delete btn-delete-redirect" data-id="<%= item.id %>" title="Delete Rule" style="background:none; border:none; cursor:pointer; color:#ef4444;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr id="noRedirectsRow">
                <td colspan="5" style="text-align:center; padding:2.5rem; color:var(--admin-text-muted);">
                  மறுதிசைவு விதிகள் எதுவும் தற்போது இல்லை. புதிய விதியை இடதுபுறப் படிவத்தில் சேர்க்கவும்.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('addRedirectForm');
    const tableBody = document.getElementById('redirectsTableBody');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fromPath = document.getElementById('fromPath').value.trim();
        const toPath = document.getElementById('toPath').value.trim();
        const statusCode = parseInt(document.getElementById('statusCode').value, 10);

        const btn = document.getElementById('btnAddRedirect');
        btn.disabled = true;
        btn.textContent = 'சேமிக்கிறது...';

        try {
          const res = await fetch('/api/redirects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fromPath, toPath, statusCode })
          });

          const data = await res.json();
          if (data && data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Error creating redirect');
          }
        } catch (err) {
          alert('Network error creating redirect: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = '+ மறுதிசைவைச் சேர் (Save Rule)';
        }
      });
    }

    document.querySelectorAll('.btn-delete-redirect').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!confirm('இந்த மறுதிசைவு விதியை நீக்க விரும்புகிறீர்களா? (Delete redirect rule?)')) return;

        try {
          const res = await fetch(`/api/redirects/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (data && data.success) {
            const row = document.getElementById(`redirect-row-${id}`);
            if (row) row.remove();
          } else {
            alert(data.message || 'Error deleting redirect');
          }
        } catch (err) {
          alert('Error: ' + err.message);
        }
      });
    });
  });
</script>

<%- include('layout-footer') %>
