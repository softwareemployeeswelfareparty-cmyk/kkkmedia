    <button type="button" class="page-tab-btn active" data-tab="about" style="padding:0.9rem 1.25rem; font-weight:600; font-size:0.95rem; border:none; background:none; cursor:pointer; color:var(--admin-primary); border-bottom:3px solid var(--admin-primary); white-space:nowrap;">
      📄 எங்களைப் பற்றி (About Us)
    </button>
    <button type="button" class="page-tab-btn" data-tab="privacy" style="padding:0.9rem 1.25rem; font-weight:600; font-size:0.95rem; border:none; background:none; cursor:pointer; color:var(--admin-text-muted); border-bottom:3px solid transparent; white-space:nowrap;">
      🛡️ தனியுரிமைக் கொள்கை (Privacy Policy)
    </button>
    <button type="button" class="page-tab-btn" data-tab="terms" style="padding:0.9rem 1.25rem; font-weight:600; font-size:0.95rem; border:none; background:none; cursor:pointer; color:var(--admin-text-muted); border-bottom:3px solid transparent; white-space:nowrap;">
      📜 பயன்பாட்டு விதிமுறைகள் (Terms)
    </button>
    <button type="button" class="page-tab-btn" data-tab="disclaimer" style="padding:0.9rem 1.25rem; font-weight:600; font-size:0.95rem; border:none; background:none; cursor:pointer; color:var(--admin-text-muted); border-bottom:3px solid transparent; white-space:nowrap;">
      ⚖️ பொறுப்புத் துறப்பு (Disclaimer)
    </button>
    <button type="button" class="page-tab-btn" data-tab="contact" style="padding:0.9rem 1.25rem; font-weight:600; font-size:0.95rem; border:none; background:none; cursor:pointer; color:var(--admin-text-muted); border-bottom:3px solid transparent; white-space:nowrap;">
      📞 தொடர்பு பக்கம் (Contact Page Intro)
    </button>
  </div>

  <form id="pageContentForm" style="padding:1.5rem;">
    
    <!-- Tab 1: About Us -->
    <div class="page-tab-pane" id="pane-about">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h2 style="font-size:1.15rem; font-weight:700; margin:0;">எங்களைப் பற்றி (About Us) பக்க உள்ளடக்கம்</h2>
          <span style="font-size:0.85rem; color:var(--admin-text-muted);">முகவரி: <a href="/about" target="_blank" style="color:var(--admin-primary);">/about</a></span>
        </div>
        <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
          <button type="button" class="btn-trans-mini" data-trans-target="content-about" data-trans-dir="ta2en">தமிழ் ➔ EN</button>
          <button type="button" class="btn-trans-mini" data-trans-target="content-about" data-trans-dir="en2ta">EN ➔ தமிழ்</button>
          <span style="border-left:1px solid var(--admin-border); height:16px; margin:0 0.2rem;"></span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-about', '<h2>', '</h2>')">H2</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-about', '<p>', '</p>')">P</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-about', '<strong>', '</strong>')"><b>B</b></button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-about', '<ul>\\n  <li>', '</li>\\n</ul>')">List</button>
        </div>
      </div>
      <textarea id="content-about" name="page_about_content" class="form-control" style="min-height:350px; font-family:'Mukta Malar', monospace; font-size:1rem; line-height:1.7;"><%= settings.page_about_content || defaultAbout %></textarea>
    </div>

    <!-- Tab 2: Privacy Policy -->
    <div class="page-tab-pane" id="pane-privacy" style="display:none;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h2 style="font-size:1.15rem; font-weight:700; margin:0;">தனியுரிமைக் கொள்கை (Privacy Policy) பக்க உள்ளடக்கம்</h2>
          <span style="font-size:0.85rem; color:var(--admin-text-muted);">முகவரி: <a href="/privacy-policy" target="_blank" style="color:var(--admin-primary);">/privacy-policy</a></span>
        </div>
        <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
          <button type="button" class="btn-trans-mini" data-trans-target="content-privacy" data-trans-dir="ta2en">தமிழ் ➔ EN</button>
          <button type="button" class="btn-trans-mini" data-trans-target="content-privacy" data-trans-dir="en2ta">EN ➔ தமிழ்</button>
          <span style="border-left:1px solid var(--admin-border); height:16px; margin:0 0.2rem;"></span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-privacy', '<h2>', '</h2>')">H2</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-privacy', '<p>', '</p>')">P</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-privacy', '<strong>', '</strong>')"><b>B</b></button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-privacy', '<ul>\\n  <li>', '</li>\\n</ul>')">List</button>
        </div>
      </div>
      <textarea id="content-privacy" name="page_privacy_content" class="form-control" style="min-height:350px; font-family:'Mukta Malar', monospace; font-size:1rem; line-height:1.7;"><%= settings.page_privacy_content || defaultPrivacy %></textarea>
    </div>

    <!-- Tab 3: Terms & Conditions -->
    <div class="page-tab-pane" id="pane-terms" style="display:none;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h2 style="font-size:1.15rem; font-weight:700; margin:0;">பயன்பாட்டு விதிமுறைகள் (Terms & Conditions) பக்க உள்ளடக்கம்</h2>
          <span style="font-size:0.85rem; color:var(--admin-text-muted);">முகவரி: <a href="/terms" target="_blank" style="color:var(--admin-primary);">/terms</a></span>
        </div>
        <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
          <button type="button" class="btn-trans-mini" data-trans-target="content-terms" data-trans-dir="ta2en">தமிழ் ➔ EN</button>
          <button type="button" class="btn-trans-mini" data-trans-target="content-terms" data-trans-dir="en2ta">EN ➔ தமிழ்</button>
          <span style="border-left:1px solid var(--admin-border); height:16px; margin:0 0.2rem;"></span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-terms', '<h2>', '</h2>')">H2</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-terms', '<p>', '</p>')">P</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-terms', '<strong>', '</strong>')"><b>B</b></button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-terms', '<ul>\\n  <li>', '</li>\\n</ul>')">List</button>
        </div>
      </div>
      <textarea id="content-terms" name="page_terms_content" class="form-control" style="min-height:350px; font-family:'Mukta Malar', monospace; font-size:1rem; line-height:1.7;"><%= settings.page_terms_content || defaultTerms %></textarea>
    </div>

    <!-- Tab 4: Disclaimer -->
    <div class="page-tab-pane" id="pane-disclaimer" style="display:none;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h2 style="font-size:1.15rem; font-weight:700; margin:0;">பொறுப்புத் துறப்பு (Disclaimer & Editorial Policy) பக்க உள்ளடக்கம்</h2>
          <span style="font-size:0.85rem; color:var(--admin-text-muted);">முகவரி: <a href="/disclaimer" target="_blank" style="color:var(--admin-primary);">/disclaimer</a></span>
        </div>
        <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
          <button type="button" class="btn-trans-mini" data-trans-target="content-disclaimer" data-trans-dir="ta2en">தமிழ் ➔ EN</button>
          <button type="button" class="btn-trans-mini" data-trans-target="content-disclaimer" data-trans-dir="en2ta">EN ➔ தமிழ்</button>
          <span style="border-left:1px solid var(--admin-border); height:16px; margin:0 0.2rem;"></span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-disclaimer', '<h2>', '</h2>')">H2</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-disclaimer', '<p>', '</p>')">P</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-disclaimer', '<strong>', '</strong>')"><b>B</b></button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="insertPageTag('content-disclaimer', '<ul>\\n  <li>', '</li>\\n</ul>')">List</button>
        </div>
      </div>
      <textarea id="content-disclaimer" name="page_disclaimer_content" class="form-control" style="min-height:350px; font-family:'Mukta Malar', monospace; font-size:1rem; line-height:1.7;"><%= settings.page_disclaimer_content || defaultDisclaimer %></textarea>
    </div>

    <!-- Tab 5: Contact Page Intro -->
    <div class="page-tab-pane" id="pane-contact" style="display:none;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h2 style="font-size:1.15rem; font-weight:700; margin:0;">தொடர்பு பக்கம் முகப்புரை (Contact Page Intro)</h2>
          <span style="font-size:0.85rem; color:var(--admin-text-muted);">முகவரி: <a href="/contact" target="_blank" style="color:var(--admin-primary);">/contact</a> (அலுவலக முகவரி, மின்னஞ்சல், தொலைபேசி ஆகியவை <a href="/admin/settings" style="color:var(--admin-primary);">தள அமைப்புகளில்</a> நிர்வகிக்கப்படுகிறது)</span>
        </div>
        <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
          <button type="button" class="btn-trans-mini" data-trans-target="content-contact" data-trans-dir="ta2en">தமிழ் ➔ EN</button>
          <button type="button" class="btn-trans-mini" data-trans-target="content-contact" data-trans-dir="en2ta">EN ➔ தமிழ்</button>
        </div>
      </div>
      <textarea id="content-contact" name="page_contact_content" class="form-control" style="min-height:200px; font-family:'Mukta Malar', monospace; font-size:1rem; line-height:1.7;"><%= settings.page_contact_content || defaultContactIntro %></textarea>
    </div>

    <div style="margin-top:1.5rem; display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--admin-border); padding-top:1.25rem;">
      <span style="font-size:0.85rem; color:var(--admin-text-muted);">
        சேமித்தவுடன், பொது வலைத்தளப் பக்கங்களில் உடனடியாக மாற்றங்கள் தெரியும்.
      </span>
      <button type="submit" id="savePageBtn" class="btn btn-primary" style="padding:0.75rem 2rem; font-size:1rem;">
        பக்க மாற்றங்களைச் சேமி (Save Page Content)
      </button>
    </div>

  </form>
</div>

<script>
  function insertPageTag(targetId, openTag, closeTag) {
    const textarea = document.getElementById(targetId);
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const selected = textarea.value.substring(start, end);
    const replacement = openTag + (selected || 'உள்ளடக்கம்') + closeTag;
    textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
    textarea.focus();
    textarea.setSelectionRange(start + openTag.length, start + replacement.length - closeTag.length);
  }

  // Tab switching
  const tabButtons = document.querySelectorAll('.page-tab-btn');
  const tabPanes = document.querySelectorAll('.page-tab-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');

      tabButtons.forEach(b => {
        b.classList.remove('active');
        b.style.color = 'var(--admin-text-muted)';
        b.style.borderBottomColor = 'transparent';
      });

      btn.classList.add('active');
      btn.style.color = 'var(--admin-primary)';
      btn.style.borderBottomColor = 'var(--admin-primary)';

      tabPanes.forEach(p => p.style.display = 'none');
      const activePane = document.getElementById(`pane-${targetTab}`);
      if (activePane) activePane.style.display = 'block';
    });
  });

  // Save form handler
  const form = document.getElementById('pageContentForm');
  const saveBtn = document.getElementById('savePageBtn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const origText = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span class="trans-loading-spinner"></span> சேமிக்கப்படுகிறது...';

      try {
        const formData = new FormData(form);
        const data = {};
        for (let [k, v] of formData.entries()) {
          data[k] = v;
        }

        const res = await fetch('/api/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        if (result.success) {
          if (typeof showToast === 'function') {
            showToast('பக்க உள்ளடக்கம் வெற்றிகரமாக சேமிக்கப்பட்டது! (Page updated successfully)', 'success');
          } else {
            alert('பக்க உள்ளடக்கம் வெற்றிகரமாக சேமிக்கப்பட்டது!');
          }
        } else {
          throw new Error(result.message || 'சேமிப்பதில் தோல்வி');
        }
      } catch (err) {
        if (typeof showToast === 'function') {
          showToast('பிழை: ' + err.message, 'danger');
        } else {
          alert('பிழை: ' + err.message);
        }
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = origText;
      }
    });
  }
</script>

<%- include('layout-footer') %>
