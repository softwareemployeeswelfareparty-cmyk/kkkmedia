<!DOCTYPE html>
<html lang="ta">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'KKK Media Admin CMS' %></title>
  <!-- Dark / Light Theme & Language Anti-FOUC Initialization -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('kkk_theme');
        var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = savedTheme ? savedTheme : (systemDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);

        var savedLang = localStorage.getItem('kkk_admin_lang') || 'ta';
        document.documentElement.setAttribute('lang', savedLang);
        document.documentElement.setAttribute('data-admin-lang', savedLang);
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= typeof settings !== 'undefined' && settings.site_favicon ? settings.site_favicon : '/images/favicon.png' %>?v=2">
  <link rel="shortcut icon" href="/favicon.ico?v=2">
  <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.site_logo ? settings.site_logo : '/images/logo.png' %>">
</head>
<body>

<div class="admin-wrapper">
  <!-- Admin Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo" style="display: flex; align-items: center; gap: 10px;">
        <img src="<%= (typeof settings !== 'undefined' && settings.site_logo) ? settings.site_logo : '/images/logo.png' %>" alt="KKK Media" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid rgba(220, 38, 38, 0.4); box-shadow: 0 0 10px rgba(220,38,38,0.3);" onerror="this.onerror=null; this.src='/images/logo.png';">
        <span style="font-weight: 700; letter-spacing: 0.5px;">MEDIA CMS</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-title" data-admin-i18n="nav_main">முக்கிய பிரிவு (Main)</div>
      <a href="/admin/dashboard" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        <span data-admin-i18n="nav_dashboard">கட்டுப்பாட்டு அறை (Dashboard)</span>
      </a>

      <div class="nav-section-title" data-admin-i18n="nav_content">செய்திகள் மேலாண்மை (Content)</div>
      <a href="/admin/articles" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'articles' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span data-admin-i18n="nav_all_articles">அனைத்து செய்திகள் (Articles)</span>
      </a>
      <a href="/admin/articles/new" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'articles-new' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span data-admin-i18n="nav_new_article">புதிய செய்தி (New Article)</span>
      </a>
      <a href="/admin/categories" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'categories' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        <span data-admin-i18n="nav_categories">பிரிவுகள் (Categories)</span>
      </a>
      <a href="/admin/media" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'media' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <span data-admin-i18n="nav_media">மீடியா நூலகம் (Media Assets)</span>
      </a>
      <a href="/admin/pages" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'pages' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        <span data-admin-i18n="nav_pages">முக்கிய பக்கங்கள் (Pages)</span>
      </a>

      <div class="nav-section-title" data-admin-i18n="nav_config">அமைப்புகள் (Configuration)</div>
      <% if (locals.currentUser && locals.currentUser.role === 'ADMIN') { %>
        <a href="/admin/redirects" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'redirects' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 10 4 15 9 20"></polyline><path d="M20 4v7a4 4 0 0 1-4 4H4"></path></svg>
          <span data-admin-i18n="nav_redirects">மறுதிசைவுகள் (URL Redirects)</span>
        </a>
        <a href="/admin/errors" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'errors' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          <span data-admin-i18n="nav_errors">பிழைகள் கண்காணிப்பு (Error Monitor)</span>
        </a>
        <a href="/admin/settings" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'settings' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          <span data-admin-i18n="nav_settings">தள அமைப்புகள் (Settings)</span>
        </a>
      <% } %>
      <a href="/admin/profile" class="sidebar-link <%= typeof activeTab !== 'undefined' && activeTab === 'profile' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span data-admin-i18n="nav_profile">சுயவிவரம் (My Profile)</span>
      </a>

      <div style="margin-top:auto; padding-top:1rem;">
        <a href="/" target="_blank" class="sidebar-link" style="color:var(--admin-primary); background:rgba(200,16,46,0.1);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          <span data-admin-i18n="nav_visit_site">வலைத்தளத்தைப் பார்க்க (Visit Site)</span>
        </a>
      </div>
    </nav>

    <div class="sidebar-footer">
      <div class="user-snippet">
        <div class="user-avatar-circle">
          <%= locals.currentUser ? locals.currentUser.name.charAt(0) : 'A' %>
        </div>
        <div class="user-name-role">
          <span class="user-name-label"><%= locals.currentUser ? locals.currentUser.name : 'Admin' %></span>
          <span class="user-role-label"><%= locals.currentUser ? locals.currentUser.role : 'ADMIN' %></span>
        </div>
      </div>
      <a href="/admin/logout" title="வெளியேறு (Logout)" data-admin-i18n-title="btn_logout" style="color:#ef4444; padding:0.25rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
      </a>
    </div>
  </aside>

  <!-- Main Content Layout -->
  <div class="admin-main">
    <header class="admin-topbar">
      <div class="topbar-left">
        <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle Navigation">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div style="font-weight:600; font-size:1rem; color:var(--admin-dark-bg);" data-admin-i18n="topbar_title">
          KKK Media செய்தி நிர்வாக தளம்
        </div>
      </div>

      <div class="topbar-right">
        <!-- Language Switcher Dropdown (English & Tamil) -->
        <div class="admin-lang-wrap" id="adminLangWrap">
          <button type="button" class="admin-lang-btn" id="adminLangBtn" aria-label="Language Selector" aria-expanded="false" title="மொழியைத் தேர்வு செய்க / Select Language">
            <svg class="admin-lang-globe" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="admin-lang-current" id="adminLangCurrentLabel">தமிழ்</span>
            <svg class="admin-lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="admin-lang-dropdown" id="adminLangDropdown" role="menu">
            <div class="admin-lang-header">
              <span data-admin-i18n="lang_menu_title">நிர்வாக மொழி / Admin Language</span>
            </div>
            <button type="button" class="admin-lang-option" data-lang="ta" role="menuitem">
              <span class="admin-lang-pill">TA</span>
              <div class="admin-lang-texts">
                <span class="admin-lang-name">தமிழ்</span>
                <span class="admin-lang-sub">Tamil</span>
              </div>
              <span class="admin-lang-check">✓</span>
            </button>
            <button type="button" class="admin-lang-option" data-lang="en" role="menuitem">
              <span class="admin-lang-pill">EN</span>
              <div class="admin-lang-texts">
                <span class="admin-lang-name">English</span>
                <span class="admin-lang-sub">ஆங்கிலம்</span>
              </div>
              <span class="admin-lang-check">✓</span>
            </button>
          </div>
        </div>

        <button type="button" class="theme-toggle-btn admin-theme-toggle" id="adminThemeToggleBtn" aria-label="Toggle Dark / Light Theme" title="கருப்பு / வெளிர் நிற மாற்றம்" data-admin-i18n-title="theme_toggle">
          <span class="theme-icon-sun" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </span>
          <span class="theme-icon-moon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </span>
        </button>
        <a href="/" target="_blank" class="btn-view-site">
          <span data-admin-i18n="topbar_view_site">தளத்தைப் பார்</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
        <a href="/admin/articles/new" class="btn btn-primary btn-sm">
          <span data-admin-i18n="topbar_new_article">+ புதிய செய்தி</span>
        </a>
      </div>
    </header>

    <div class="admin-content">
