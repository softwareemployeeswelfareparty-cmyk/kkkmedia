<%- include('layout-header') %>

<div class="page-header-row">
  <div>
    <h1 class="page-title" data-admin-i18n="settings_title">தள அமைப்புகள் (Site Settings)</h1>
    <p class="page-subtitle" data-admin-i18n="settings_subtitle">வலைத்தளத்தின் அடையாளங்கள், தொடர்புகள், சமூக ஊடகங்கள் மற்றும் விளம்பர அமைப்புகள்.</p>
  </div>
</div>

<form id="settingsForm">
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1.75rem;">
    
    <!-- Branding & SEO -->
    <div class="admin-card">
      <div class="card-header-padded">
        <h2 style="font-size:1.1rem; font-weight:700;" data-admin-i18n="settings_branding">அடையாளம் & அடிப்படை (Branding)</h2>
      </div>
      <div class="card-body-padded">
        
        <div class="form-group">
          <label class="form-label" data-admin-i18n="settings_site_name">தளத்தின் பெயர் (Site Name)</label>
          <input type="text" name="site_name" class="form-control" value="<%= settings.site_name || 'KKK Media' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" data-admin-i18n="settings_tagline">தளத்தின் தமிழ் முழக்கம் (Tagline)</label>
          <input type="text" name="site_tagline" class="form-control" value="<%= settings.site_tagline || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" data-admin-i18n="settings_meta_desc">தள விவரிப்பு (Site Meta Description)</label>
          <textarea name="site_description" class="form-control" style="min-height:80px;"><%= settings.site_description || '' %></textarea>
        </div>

        <!-- 1. Dedicated Option for Site Logo -->
        <div class="form-group" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:1rem; margin-bottom:1.25rem;">
          <label class="form-label" style="font-weight:700; color:#0f172a; display:flex; align-items:center; gap:0.5rem;">
            <span>🖼️ தள முதன்மை இலச்சினை (Site Logo)</span>
          </label>
          <div style="display:flex; gap:0.75rem; align-items:center; margin-bottom:0.5rem;">
            <input type="text" name="site_logo" id="site_logo" class="form-control" placeholder="/images/logo.png" value="<%= settings.site_logo || '/images/logo.png' %>">
            <button type="button" class="btn btn-secondary" id="btnUploadLogo" style="white-space:nowrap; padding:0.55rem 0.9rem; font-size:0.85rem; font-weight:600;">
              📤 லோகோ பதிவேற்று
            </button>
            <input type="file" id="logoFileInput" accept="image/*" style="display:none;">
          </div>
          <div style="display:flex; align-items:center; gap:0.75rem; margin-top:0.5rem;">
            <div style="width:52px; height:52px; border-radius:50%; border:2px solid #ef4444; overflow:hidden; background:#111827; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 0 10px rgba(239,68,68,0.25);">
              <img id="logoPreview" src="<%= settings.site_logo || '/images/logo.png' %>" alt="Logo Preview" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/images/kkkmedia-logo.svg'">
            </div>
            <div class="form-help" style="margin:0;">இணையதளத்தின் தலைப்பு (Header), அடிக்குறிப்பு (Footer) மற்றும் நிர்வாக தளத்தில் தோன்றும் அதிகாரப்பூர்வ லோகோ.</div>
          </div>
        </div>

        <!-- 2. Dedicated Option for Browser Favicon -->
        <div class="form-group" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:1rem; margin-bottom:1.25rem;">
          <label class="form-label" style="font-weight:700; color:#0f172a; display:flex; align-items:center; gap:0.5rem;">
            <span>🌐 உலாவி ஐகான் (Browser Favicon)</span>
          </label>
          <div style="display:flex; gap:0.75rem; align-items:center; margin-bottom:0.5rem;">
            <input type="text" name="site_favicon" id="site_favicon" class="form-control" placeholder="/images/favicon.png or /favicon.ico" value="<%= settings.site_favicon || '/images/favicon.png' %>">
            <button type="button" class="btn btn-secondary" id="btnUploadFavicon" style="white-space:nowrap; padding:0.55rem 0.9rem; font-size:0.85rem; font-weight:600;">
              📤 ஐகான் பதிவேற்று
            </button>
            <input type="file" id="faviconFileInput" accept="image/*,.ico" style="display:none;">
          </div>
          <div style="display:flex; align-items:center; gap:0.75rem; margin-top:0.5rem;">
            <div style="width:36px; height:36px; border:1px solid #cbd5e1; border-radius:6px; overflow:hidden; background:#ffffff; display:flex; align-items:center; justify-content:center; flex-shrink:0; padding:2px;">
              <img id="faviconPreview" src="<%= settings.site_favicon || '/images/favicon.png' %>" alt="Favicon Preview" style="width:100%; height:100%; object-fit:contain;" onerror="this.src='/images/favicon.svg'">
            </div>
            <div class="form-help" style="margin:0;">உலாவியின் தத்தல் (Browser Tab) மற்றும் புக்மார்க்குகளில் தோன்றும் 32x32 ஐகான்.</div>
          </div>
        </div>

        <div class="form-group">
          <label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-size:0.875rem;">
            <input type="checkbox" name="breaking_news_enabled" id="breaking_news_enabled" style="width:18px; height:18px; accent-color:var(--admin-primary);" <%= settings.breaking_news_enabled === 'true' ? 'checked' : '' %>>
            <span><strong data-admin-i18n="settings_enable_ticker">முக்கிய செய்திகள் டிக்கரை இயக்கு (Enable Breaking Ticker)</strong></span>
          </label>
        </div>

      </div>
    </div>

    <!-- Contact Information -->
    <div class="admin-card">
      <div class="card-header-padded">
        <h2 style="font-size:1.1rem; font-weight:700;" data-admin-i18n="settings_contact">தொடர்பு விவரங்கள் (Contact Details)</h2>
      </div>
      <div class="card-body-padded">
        
        <div class="form-group">
          <label class="form-label" data-admin-i18n="settings_email">அலுவலக மின்னஞ்சல் (Contact Email)</label>
          <input type="email" name="contact_email" class="form-control" value="<%= settings.contact_email || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" data-admin-i18n="settings_phone">தொலைபேசி எண் (Contact Phone)</label>
          <input type="text" name="contact_phone" class="form-control" value="<%= settings.contact_phone || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" data-admin-i18n="settings_address">அலுவலக முகவரி (Office Address)</label>
          <textarea name="contact_address" class="form-control" style="min-height:80px;"><%= settings.contact_address || '' %></textarea>
        </div>

      </div>
    </div>

    <!-- Social Media Links -->
    <div class="admin-card">
      <div class="card-header-padded">
        <h2 style="font-size:1.1rem; font-weight:700;" data-admin-i18n="settings_social">சமூக ஊடக இணைப்புகள் (Social Channels)</h2>
      </div>
      <div class="card-body-padded">
        
        <div class="form-group">
          <label class="form-label">Facebook Page URL</label>
          <input type="url" name="social_facebook" class="form-control" value="<%= settings.social_facebook || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">X (Twitter) Profile URL</label>
          <input type="url" name="social_twitter" class="form-control" value="<%= settings.social_twitter || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">YouTube Channel URL</label>
          <input type="url" name="social_youtube" class="form-control" value="<%= settings.social_youtube || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Telegram Channel URL</label>
          <input type="url" name="social_telegram" class="form-control" value="<%= settings.social_telegram || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">WhatsApp Channel URL</label>
          <input type="url" name="social_whatsapp" class="form-control" value="<%= settings.social_whatsapp || '' %>">
        </div>

      </div>
    </div>

    <!-- Google AdSense Settings -->
    <div class="admin-card">
      <div class="card-header-padded">
        <h2 style="font-size:1.1rem; font-weight:700;">கூகுள் அட்சென்ஸ் விளம்பரங்கள் (Google AdSense)</h2>
      </div>
      <div class="card-body-padded">
        
        <div class="form-group">
          <label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-size:0.875rem; margin-bottom:1rem;">
            <input type="checkbox" name="adsense_enabled" id="adsense_enabled" style="width:18px; height:18px; accent-color:var(--admin-primary);" <%= settings.adsense_enabled ? 'checked' : '' %>>
            <span><strong>விளம்பர இடங்களை இயக்கு (Enable Ad Units)</strong></span>
          </label>
          <div class="form-help">இயக்கினால், தலைப்பு பகுதி, செய்திக்கு உள்ளே மற்றும் பக்கவாட்டில் விளம்பர இடங்கள் தோன்றும்.</div>
        </div>

        <div class="form-group">
          <label class="form-label">Google AdSense Publisher ID</label>
          <input type="text" name="adsense_client_id" class="form-control" placeholder="ca-pub-1234567890123456" value="<%= settings.adsense_client_id || '' %>">
          <div class="form-help">AdSense கணக்கில் உள்ள உங்கள் பப்ளிஷர் ஐடி (ca-pub-...).</div>
        </div>

        <div class="form-group">
          <label class="form-label">Ad Unit Slot ID (விருப்பத்தேர்வு / Optional)</label>
          <input type="text" name="adsense_slot_id" class="form-control" placeholder="1234567890" value="<%= settings.adsense_slot_id || '' %>">
          <div class="form-help">குறிப்பிட்ட விளம்பர தொகுதி எண் (Ad Unit ID). காலியாக விட்டால் தானியங்கி விளம்பரங்கள் (Auto Ads) செயல்படும்.</div>
        </div>

        <div style="font-size:0.8rem; color:#64748b; background:#f1f5f9; padding:0.6rem 0.8rem; border-radius:6px; border-left:3px solid #0284c7;">
          ℹ️ <strong>உண்மை விளம்பரங்களை இயக்க:</strong> கூகுள் அட்சென்ஸ் ஒப்புதல் (Approval) பெற்ற பின், பப்ளிஷர் ஐடியை உள்ளிட்டு சேமிக்கவும். தளம் நேரலையில் (Production Domain) இருக்கும் போது தானாகவே உண்மையான விளம்பரங்கள் தோன்றும். <a href="/ads.txt" target="_blank" style="color:#0284c7; text-decoration:underline;">ads.txt கோப்பைப் பார்க்க ↗</a>
        </div>

      </div>
    </div>

    <!-- Cache Management & Instant Revalidation -->
    <div class="admin-card" style="grid-column: span 2;">
      <div class="card-header-padded" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
        <div>
          <h2 style="font-size:1.1rem; font-weight:700;">கேச் & உடனடி புதுப்பிப்பு (Cache & Revalidation)</h2>
          <p style="font-size:0.85rem; color:#64748b; margin:0.25rem 0 0 0;">பொதுப் பக்கங்கள் மற்றும் அமைப்புகளின் கேச்சை அழித்து உடனடியாக இணையதளத்தில் புதிய மாற்றங்களைப் பிரதிபலிக்கச் செய்க.</p>
        </div>
        <button type="button" id="btnRevalidateCache" class="btn" style="background:#0284c7; color:#fff; display:inline-flex; align-items:center; gap:0.5rem; font-weight:600; padding:0.6rem 1.25rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          <span>கேச் புதுப்பி (Purge & Revalidate Cache)</span>
        </button>
      </div>
      <div class="card-body-padded" style="background:#f8fafc; border-top:1px solid #e2e8f0;">
        <div style="font-size:0.875rem; color:#475569; display:flex; align-items:center; gap:0.75rem;">
          <span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#10b981; flex-shrink:0;"></span>
          <span><strong>தானியங்கி புதுப்பிப்பு இயங்குகிறது (Auto-Revalidation Active):</strong> புதிய செய்திகள் வெளியிடும் போதோ அல்லது அமைப்புகள் சேமிக்கப்படும் போதோ கேச் தானாகவே அழிக்கப்பட்டு புதுப்பிக்கப்படும். ஏதேனும் முரண்பாடுகள் இருப்பின் மேலே உள்ள பொத்தானை அழுத்தி உடனடியாக கேச்சை அழிக்கலாம்.</span>
        </div>
      </div>
    </div>

  </div>

  <div style="margin-top:1.5rem; text-align:right;">
    <button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem; font-size:1rem;" data-admin-i18n="settings_btn_save">
      தள அமைப்புகளைச் சேமி (Save Settings)
    </button>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Live Preview handlers
    const logoInput = document.getElementById('site_logo');
    const logoPrev = document.getElementById('logoPreview');
    if (logoInput && logoPrev) {
      logoInput.addEventListener('input', () => {
        logoPrev.src = logoInput.value.trim() || '/images/logo.png';
      });
    }

    const favInput = document.getElementById('site_favicon');
    const favPrev = document.getElementById('faviconPreview');
    if (favInput && favPrev) {
      favInput.addEventListener('input', () => {
        favPrev.src = favInput.value.trim() || '/images/favicon.png';
      });
    }

    // 2. Direct Logo Upload Handler
    const btnUploadLogo = document.getElementById('btnUploadLogo');
    const logoFileInput = document.getElementById('logoFileInput');
    if (btnUploadLogo && logoFileInput) {
      btnUploadLogo.addEventListener('click', () => logoFileInput.click());
      logoFileInput.addEventListener('change', async () => {
        const file = logoFileInput.files[0];
        if (!file) return;
        const formData = new FormData();
        formData.append('image', file);
        formData.append('altText', 'KKK Media Logo');
        btnUploadLogo.disabled = true;
        btnUploadLogo.textContent = 'பதிவேற்றப்படுகிறது...';
        try {
          const res = await fetch('/api/media/upload', { method: 'POST', body: formData });
          const data = await res.json();
          if (data.success && data.data && data.data.url) {
            if (logoInput) logoInput.value = data.data.url;
            if (logoPrev) logoPrev.src = data.data.url;
            alert('லோகோ வெற்றிகரமாக பதிவேற்றப்பட்டது! மாற்றங்களை உறுதிசெய்ய "தள அமைப்புகளைச் சேமி" பொத்தானை அழுத்தவும்.');
          } else {
            alert('லோகோ பதிவேற்றம் தோல்வியடைந்தது: ' + (data.message || 'Error'));
          }
        } catch (err) {
          alert('Network error: ' + err.message);
        } finally {
          btnUploadLogo.disabled = false;
          btnUploadLogo.textContent = '📤 லோகோ பதிவேற்று';
        }
      });
    }

    // 3. Direct Favicon Upload Handler
    const btnUploadFavicon = document.getElementById('btnUploadFavicon');
    const faviconFileInput = document.getElementById('faviconFileInput');
    if (btnUploadFavicon && faviconFileInput) {
      btnUploadFavicon.addEventListener('click', () => faviconFileInput.click());
      faviconFileInput.addEventListener('change', async () => {
        const file = faviconFileInput.files[0];
        if (!file) return;
        const formData = new FormData();
        formData.append('image', file);
        formData.append('altText', 'KKK Media Favicon');
        btnUploadFavicon.disabled = true;
        btnUploadFavicon.textContent = 'பதிவேற்றப்படுகிறது...';
        try {
          const res = await fetch('/api/media/upload', { method: 'POST', body: formData });
          const data = await res.json();
          if (data.success && data.data && data.data.url) {
            if (favInput) favInput.value = data.data.url;
            if (favPrev) favPrev.src = data.data.url;
            alert('ஃபேவிகான் ஐகான் வெற்றிகரமாக பதிவேற்றப்பட்டது! மாற்றங்களை உறுதிசெய்ய "தள அமைப்புகளைச் சேமி" பொத்தானை அழுத்தவும்.');
          } else {
            alert('ஃபேவிகான் பதிவேற்றம் தோல்வியடைந்தது: ' + (data.message || 'Error'));
          }
        } catch (err) {
          alert('Network error: ' + err.message);
        } finally {
          btnUploadFavicon.disabled = false;
          btnUploadFavicon.textContent = '📤 ஐகான் பதிவேற்று';
        }
      });
    }

    // 4. Cache Revalidation Handler
    const btnReval = document.getElementById('btnRevalidateCache');
    if (btnReval) {
      btnReval.addEventListener('click', async () => {
        const origContent = btnReval.innerHTML;
        btnReval.disabled = true;
        btnReval.innerHTML = '<span>புதுப்பிக்கப்படுகிறது...</span>';
        try {
          const res = await fetch('/api/settings/revalidate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || 'கேச் வெற்றிகரமாக புதுப்பிக்கப்பட்டது!');
          } else {
            alert('கேச் புதுப்பிப்பதில் தோல்வி: ' + (data.message || 'Unknown error'));
          }
        } catch (err) {
          alert('தொடர்பு பிழை: ' + err.message);
        } finally {
          btnReval.disabled = false;
          btnReval.innerHTML = origContent;
        }
      });
    }
  });
</script>

<%- include('layout-footer') %>
