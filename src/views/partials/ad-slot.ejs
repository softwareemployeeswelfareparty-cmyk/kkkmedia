<% if (typeof settings !== 'undefined' && settings.adsense_enabled) { %>
  <div class="ad-banner-slot" role="region" aria-label="Advertisement">
    <div class="ad-box">
      <span class="ad-label">விளம்பரம் / SPONSORED CONTENT</span>
      <% if (process.env.NODE_ENV === 'production' && settings.adsense_client_id && !settings.adsense_client_id.includes('1234567890')) { %>
        <!-- Live Google AdSense Responsive Unit -->
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="<%= settings.adsense_client_id %>"
             <% if (settings.adsense_slot_id) { %>data-ad-slot="<%= settings.adsense_slot_id %>"<% } %>
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      <% } else { %>
        <!-- Google AdSense Placement Preview -->
        <div style="font-size:0.85rem; color:#888; padding:0.5rem 0;">
          [ Google AdSense Responsive Unit: <%= settings.adsense_client_id || 'ca-pub-1234567890123456' %> ]
        </div>
      <% } %>
    </div>
  </div>
<% } %>
