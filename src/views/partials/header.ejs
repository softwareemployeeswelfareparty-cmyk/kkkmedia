<!DOCTYPE html>
<html lang="ta">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'KKK Media — தமிழின் முன்னணி டிஜிட்டல் செய்தி தளம்' %></title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'KKK Media brings breaking Tamil news across Tamil Nadu politics, TVK, DMK, cinema, sports and world affairs.' %>">
  <% if (typeof keywords !== 'undefined' && keywords) { %>
    <meta name="keywords" content="<%= keywords %>">
  <% } %>
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : appUrl + currentPath %>">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= typeof article !== 'undefined' ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'KKK Media' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : '' %>">
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : appUrl + currentPath %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : appUrl + '/images/kkkmedia-og.jpg' %>">
  <meta property="og:site_name" content="KKK Media">

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'KKK Media' %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : '' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : appUrl + '/images/kkkmedia-og.jpg' %>">

  <!-- Schema.org Structured Data -->
  <% if (typeof schemaNewsArticle !== 'undefined') { %>
    <script type="application/ld+json">
      <%- schemaNewsArticle %>
    </script>
  <% } %>
  <% if (typeof schemaBreadcrumbs !== 'undefined') { %>
    <script type="application/ld+json">
      <%- schemaBreadcrumbs %>
    </script>
  <% } %>

  <!-- Dark / Light Theme Anti-FOUC Initialization -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('kkk_theme');
        var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = savedTheme ? savedTheme : (systemDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" type="image/png" href="/images/favicon.png">
</head>
<body>

  <!-- Top Utility Bar -->
  <div class="top-bar">
    <div class="container">
      <div class="top-bar-date">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="currentDateDisplay">KKK Media — தமிழ்நாடு செய்திகள்</span>
      </div>
      <div class="top-bar-links">
        <a href="/about">எங்களைப் பற்றி</a>
        <a href="/contact">தொடர்புக்கு</a>
        <% if (locals.currentUser) { %>
          <a href="/admin/dashboard" class="admin-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            CMS Dashboard (<%= currentUser.name.split(' ')[0] %>)
          </a>
        <% } else { %>
          <a href="/admin/login" style="font-size:0.75rem; color:var(--grey-400);">Admin Login</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Main Header with Logo -->
  <header class="main-header">
    <div class="container header-brand-row">
      <a href="/" class="logo-container">
        <div class="logo-badge">KKK</div>
        <div class="logo-text">
          <div class="logo-title">KKK <span>MEDIA</span></div>
          <div class="logo-tagline"><%= typeof settings !== 'undefined' && settings.site_tagline ? settings.site_tagline : 'தமிழின் முன்னணி டிஜிட்டல் செய்தி தளம்' %></div>
        </div>
      </a>

      <div class="header-actions">
        <button class="search-trigger-btn search-modal-trigger" aria-label="செய்திகள் தேடுக">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <span>செய்திகள் தேடுக...</span>
        </button>

        <button class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle Dark / Light Theme" title="கருப்பு / வெளிர் நிற மாற்றம்">
          <span class="theme-icon-sun" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </span>
          <span class="theme-icon-moon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </span>
        </button>

        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="பட்டியல் திறக்க">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
      </div>
    </div>

    <!-- Category Navigation Bar -->
    <nav class="category-nav-bar" aria-label="Category Navigation">
      <div class="container">
        <ul class="category-nav-list">
          <li class="category-nav-item home-icon <%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>">
            <a href="/" aria-label="Home">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </a>
          </li>
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(function(cat) { %>
              <li class="category-nav-item <%= typeof activeNav !== 'undefined' && activeNav === cat.slug ? 'active' : '' %>">
                <a href="/category/<%= cat.slug %>"><%= cat.nameTamil %></a>
              </li>
            <% }); %>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Breaking News Ticker -->
  <% if (typeof breaking !== 'undefined' && breaking.length > 0) { %>
    <section class="breaking-news-section" aria-label="முக்கிய செய்திகள்">
      <div class="container">
        <div class="ticker-wrap">
          <div class="ticker-badge">
            <span class="pulse-dot"></span>
            <span>முக்கிய செய்திகள்</span>
          </div>
          <div class="ticker-content">
            <% breaking.forEach(function(item, idx) { %>
              <div class="ticker-item <%= idx === 0 ? 'active' : '' %>">
                <a href="/news/<%= item.slug %>">
                  <span style="color:var(--primary-red); margin-right:6px;">[<%= item.category.nameTamil %>]</span>
                  <%= item.title %>
                </a>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>
  <aside class="mobile-nav-drawer" id="mobileNavDrawer">
    <div class="mobile-nav-header">
      <div class="logo-container">
        <div class="logo-badge" style="font-size:1.2rem;">KKK</div>
        <div class="logo-title" style="color:#fff; font-size:1.3rem;">KKK <span>MEDIA</span></div>
      </div>
      <button class="close-drawer-btn" id="closeDrawerBtn">&times;</button>
    </div>
    <div class="mobile-nav-links">
      <a href="/" class="<%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>">முகப்பு (Home)</a>
      <% if (typeof categories !== 'undefined') { %>
        <% categories.forEach(function(cat) { %>
          <a href="/category/<%= cat.slug %>" class="<%= typeof activeNav !== 'undefined' && activeNav === cat.slug ? 'active' : '' %>">
            <%= cat.nameTamil %>
          </a>
        <% }); %>
      <% } %>
      <div class="mobile-theme-row">
        <span>இருண்ட பயன்முறை (Dark Theme)</span>
        <button class="theme-toggle-btn mobile-theme-btn" aria-label="Toggle Dark / Light Theme" title="கருப்பு / வெளிர் நிற மாற்றம்">
          <span class="theme-icon-sun" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </span>
          <span class="theme-icon-moon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </span>
        </button>
      </div>
      <hr style="border:none; border-top:1px solid rgba(255,255,255,0.1); margin:1rem 0;">
      <a href="/about">எங்களைப் பற்றி</a>
      <a href="/contact">தொடர்புக்கு</a>
      <a href="/privacy-policy">தனியுரிமைக் கொள்கை</a>
      <a href="/disclaimer">பொறுப்புத் துறப்பு</a>
      <% if (locals.currentUser) { %>
        <a href="/admin/dashboard" style="color:var(--primary-light-red); font-weight:700;">Admin Dashboard</a>
      <% } else { %>
        <a href="/admin/login" style="color:var(--grey-400);">Admin Login</a>
      <% } %>
    </div>
  </aside>

  <!-- Search Modal -->
  <div class="search-modal-backdrop" id="searchModalBackdrop">
    <div class="search-modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h3 style="font-size:1.1rem; font-weight:700;">செய்திகள் தேடுக (Search News)</h3>
        <button type="button" id="searchModalClose" style="background:none; border:none; font-size:1.4rem; cursor:pointer;">&times;</button>
      </div>
      <form action="/search" method="GET" class="search-modal-form">
        <input type="text" name="q" id="searchModalInput" class="search-input" placeholder="தலைப்பு அல்லது முக்கிய சொல் உள்ளிடவும்..." required>
        <button type="submit" class="search-submit-btn">தேடு</button>
      </form>
    </div>
  </div>
