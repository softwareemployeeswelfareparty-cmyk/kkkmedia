<%- include('layout-header') %>

<div class="page-header-row">
  <div>
    <h1 class="page-title" data-admin-i18n="media_title">மீடியா நூலகம் (Media Assets Library)</h1>
    <p class="page-subtitle" data-admin-i18n="media_subtitle">செய்திகளுக்கு பதிவேற்றப்பட்ட புகைப்படங்கள் மற்றும் ஊடகக் கோப்புகள்.</p>
  </div>
</div>

<!-- Upload Box -->
<div class="admin-card" style="margin-bottom:1.75rem;">
  <div class="card-body-padded">
    <div style="display:flex; gap:1.5rem; align-items:center; flex-wrap:wrap;">
      <input type="file" id="mediaUploadInput" accept="image/*" style="display:none;">
      <button type="button" class="btn btn-primary" onclick="document.getElementById('mediaUploadInput').click();">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        <span data-admin-i18n="media_btn_upload">புதிய படம் பதிவேற்றுக (Upload Image)</span>
      </button>
      <div style="font-size:0.85rem; color:var(--admin-text-muted);" data-admin-i18n="media_format_hint">
        அனுமதிக்கப்பட்ட வடிவங்கள்: JPG, PNG, WEBP, GIF, SVG (அதிகபட்சம் 5MB)
      </div>
    </div>
  </div>
</div>

<!-- Media Grid -->
<div class="admin-card">
  <div class="card-header-padded">
    <h2 style="font-size:1.1rem; font-weight:700;" data-admin-i18n="media_saved_files">சேமிக்கப்பட்ட கோப்புகள் (Uploaded Files)</h2>
    <span style="font-size:0.85rem; color:var(--admin-text-muted);">மொத்தம்: <%= pagination.total %></span>
  </div>
  <div class="card-body-padded">
    <% if (media && media.length > 0) { %>
      <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap:1.25rem;">
        <% media.forEach(function(item) { %>
          <div style="border:1px solid var(--admin-border); border-radius:var(--radius-sm); overflow:hidden; background:#fff; display:flex; flex-direction:column;">
            <div style="width:100%; height:130px; background:#f3f4f6; overflow:hidden;">
              <img src="<%= item.url %>" alt="<%= item.altText || item.originalName %>" style="width:100%; height:100%; object-fit:cover;">
            </div>
            <div style="padding:0.75rem; flex:1; display:flex; flex-direction:column; justify-content:space-between;">
              <div style="font-size:0.8rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:0.25rem;" title="<%= item.originalName %>">
                <%= item.originalName %>
              </div>
              <div style="font-size:0.7rem; color:var(--admin-text-muted); margin-bottom:0.5rem;">
                <%= Math.round(item.size / 1024) %> KB
              </div>
              <div style="display:flex; gap:0.35rem;">
                <button type="button" class="btn btn-secondary btn-sm" style="flex:1; font-size:0.7rem; padding:0.25rem;" onclick="copyToClipboard('<%= item.url %>')" data-admin-i18n="media_copy_url">
                  Copy URL
                </button>
                <button type="button" class="btn btn-danger btn-sm" style="font-size:0.7rem; padding:0.25rem 0.5rem;" onclick="deleteMediaAsset('<%= item.id %>')">
                  ✕
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:3rem; color:var(--admin-text-muted);" data-admin-i18n="media_empty">
        இன்னும் படங்கள் பதிவேற்றப்படவில்லை.
      </div>
    <% } %>
  </div>
</div>

<script>
  document.getElementById('mediaUploadInput').addEventListener('change', async (e) => {
    if (!e.target.files || !e.target.files[0]) return;
    const file = e.target.files[0];
    const formData = new FormData();
    formData.append('image', file);
    formData.append('altText', file.name);

    try {
      showToast('படம் பதிவேற்றப்படுகிறது... (Uploading...)');
      const res = await fetch('/api/media/upload', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (data.success) {
        showToast('படம் வெற்றிகரமாக சேர்க்கப்பட்டது!');
        setTimeout(() => window.location.reload(), 600);
      } else {
        showToast(data.message || 'Upload failed', 'error');
      }
    } catch (err) {
      showToast('Error uploading image', 'error');
    }
  });

  function copyToClipboard(url) {
    navigator.clipboard.writeText(url).then(() => {
      showToast('படம் URL நகலெடுக்கப்பட்டது! (Copied to clipboard)');
    }).catch(() => {
      prompt('Copy URL:', url);
    });
  }

  function deleteMediaAsset(id) {
    showConfirmModal({
      title: 'படத்தை நீக்க வேண்டுமா?',
      message: 'இந்த படத்தை நீக்கினால், இது பயன்படுத்தப்பட்டுள்ள செய்திகளில் படம் தோன்றாது.',
      confirmText: 'ஆம், நீக்கு',
      onConfirm: async () => {
        try {
          const res = await fetch(`/api/media/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            showToast('படம் நீக்கப்பட்டது.');
            setTimeout(() => window.location.reload(), 600);
          } else {
            showToast(data.message || 'Error deleting media', 'error');
          }
        } catch (err) {
          showToast('Server error', 'error');
        }
      },
    });
  }
</script>

<%- include('layout-footer') %>
