# KKK Media Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://kkkmedia.com

# -------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / Standard Postgres)
# -------------------------------------------------------------
# Supabase Transaction Pooler (port 6543) - used by the running app:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (port 5432) - used by Prisma migrations:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# For instant local development without cloud connection:
# DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------
# Supabase Cloud Storage (Optional - for permanent cloud image CDN)
# -------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-service-role-key"
SUPABASE_STORAGE_BUCKET="kkkmedia"

# Local Storage (Fallback if Supabase Storage is not provided)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=5

# -------------------------------------------------------------
# JWT & Security Secrets
# -------------------------------------------------------------
JWT_SECRET="replace_with_a_secure_random_64_character_hex_or_string"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace_with_another_secure_secret_for_cookies"

# -------------------------------------------------------------
# Site Identity & Defaults
# -------------------------------------------------------------
SITE_NAME="KKK Media"
SITE_TAGLINE="தமிழின் முன்னணி டிஜிட்டல் செய்தி தளம்"
CONTACT_EMAIL="contact@kkkmedia.com"
ADMIN_DEFAULT_EMAIL="admin@kkkmedia.com"
ADMIN_DEFAULT_PASSWORD="ChangeThisPasswordImmediately123!"
